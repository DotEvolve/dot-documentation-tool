{
  "name": "@dotevolve/documentation-tool",
  "version": "1.0.0",
  "description": "Automated JSDoc documentation generator for DotEvolve projects",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest __tests__/unit",
    "test:property": "jest __tests__/property",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "documentation",
    "jsdoc",
    "code-analysis",
    "ast"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.5",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.43",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@babel/parser": "^7.23.6",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^7.23.6",
    "commander": "^14.0.3",
    "fast-check": "^4.10.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
